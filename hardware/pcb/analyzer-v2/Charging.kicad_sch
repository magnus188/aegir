	)
	(text "C108 supplements the retained C104/C105 SYS bulk.\nTP1013 exposes charger STAT on the board rear.\nR107 pulls charger/permission feedback up to 3.3 V."
		(exclude_from_sim no)
		(at 281.94 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d58d80a-adf5-4c2e-9e14-cb3d2e042ae3")
	)
	(text "Follow the top row from USB input to charger and battery. The lower row controls and monitors charging."
		(exclude_from_sim no)
		(at 20.32 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14991ac8-6b56-4a64-b3de-24bfca533dc1")
	)
