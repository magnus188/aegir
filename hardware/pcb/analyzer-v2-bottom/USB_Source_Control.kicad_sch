	)
	(text "R901/R902 on the USB board are DNP: U110 supplies both Rd terminations.\nUnpowered CC pins retain dead-battery Rd. PORT/ADDR/EN_N are hard-grounded."
		(exclude_from_sim no)
		(at 25.4 125.73 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "9503e997-bb84-4d17-bb84-d0b8175c4316")
	)
	(text "GPIO50 / J301.11: LOW selects nominal50mA; a qualified rising edge authorizes.\nU114 on sheet13 provides the input limit. R116 switches its parallel1k branch.\nBoth FETs must be ON. A CC/VBUS reset requires a new host LOW→HIGH.\nBQ current register must still match the valid source budget. CHARGE ARM stays open."
		(exclude_from_sim no)
		(at 217.17 256.54 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "a65efcdd-c21f-4f18-9700-65c1c7079294")
	)
	(text "TPS3808 is powered by HOST_3V3, separately senses USB VBUS.\nNominal falling threshold 4.358 V; corner threshold calculation in review.\nCT open: release delay 12–28 ms. Wait at least 30 ms after CC IRQ clear.\nLoss/CC change forces Q low even if the host GPIO remains stuck high.\nPower-up RESET is asserted for 0.8 V < VDD < 1.7 V.\nSub-microsecond transients and physical rail ramps require measurement."
		(exclude_from_sim no)
		(at 25.4 240.03 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "b331a811-128f-4d6a-9b12-408700f6f1e2")
	)
	(text "04  FRESH AUTHORIZATION EDGE / HARDWARE CURRENT CEILING"
		(exclude_from_sim no)
		(at 217.17 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "bdedf088-9602-4df9-abe0-f25aff464960")
	)
	(text "03  INDEPENDENT VBUS LOSS + CC RESET + STARTUP"
		(exclude_from_sim no)
		(at 25.4 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c747bad5-9f24-4831-961d-6bd52082d029")
	)
	(text "Client mode only. D+/D- never connect to the BQ25895. No PD or HVDCP.\nRead-and-clear BC status only while host permission is LOW. No USB data path."
		(exclude_from_sim no)
		(at 217.17 125.73 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
