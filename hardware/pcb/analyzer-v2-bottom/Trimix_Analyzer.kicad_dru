(version 1)
(rule "TI DRL manufacturer adjacent pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U701') && B.memberOfFootprint('U701')")
  (constraint clearance (min 0.15mm)))
(rule "TI DCU manufacturer adjacent pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U703') && B.memberOfFootprint('U703')")
  (constraint clearance (min 0.15mm)))
(rule "ADI TS8 manufacturer adjacent pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U801') && B.memberOfFootprint('U801')")
  (constraint clearance (min 0.15mm)))
(rule "Diodes UQFN engineered adjacent lands"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U111') && B.memberOfFootprint('U111')")
  (constraint clearance (min 0.15mm)))
(rule "TI AUP DCU manufacturer adjacent pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U112') && B.memberOfFootprint('U112')")
  (constraint clearance (min 0.15mm)))
(rule "U111 short fine pitch signal escapes"
  (condition "A.Type == 'Track' && (A.NetName == 'I2C_SCL' || A.NetName == 'I2C_SDA' || A.NetName == 'USB_BC_INT_N' || A.NetName == 'USB_D_M' || A.NetName == 'USB_D_P' || A.NetName == 'GND' || A.NetName == 'HOST_3V3')")
  (constraint track_width (min 0.125mm)))
(rule "BQ REGN and BTST local through via escapes"
  (condition "A.Type == 'Via' && (A.NetName == '/01  CHARGING + BATTERY/BQ_REGN' || A.NetName == '/01  CHARGING + BATTERY/BQ_BTST')")
  (constraint hole_size (min 0.20mm))
  (constraint via_diameter (min 0.45mm)))
(rule "Reviewed dense package local through vias"
 (condition "A.Type == 'Via' && (A.NetName == '/01  CHARGING + BATTERY/BQ_REGN' || A.NetName == '/01  CHARGING + BATTERY/BQ_BTST' || A.NetName == '/01  CHARGING + BATTERY/CHG_STAT_N' || A.NetName == 'I2C_SCL' || A.NetName == 'I2C_SDA' || A.NetName == 'CHG_INT_N' || A.NetName == '/01  CHARGING + BATTERY/CHG_CE_N' || A.NetName == '/01  CHARGING + BATTERY/PACK_TS' || A.NetName == 'PACK_P' || A.NetName == 'VSYS' || A.NetName == 'USB_CC1' || A.NetName == 'USB_CC2' || A.NetName == 'HOST_3V3' || A.NetName == 'USB_CC_INT_N' || A.NetName == 'GND' || A.NetName == 'USB_OVP_SET' || A.NetName == 'USB_OVP_UVLO' || A.NetName == 'USB_OVP_DVDT' || A.NetName == 'USB_D_P')")
 (constraint hole_size (min 0.20mm))
 (constraint via_diameter (min 0.45mm)))
(rule "U115 AUXOFF exact filled capped via geometry"
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm")
 (constraint hole_size (min 0.20mm) (max 0.20mm))
 (constraint via_diameter (min 0.40mm) (max 0.40mm))
 (constraint annular_width (min 0.10mm)))
(rule "U115 AUXOFF masked via extension to adjacent manufacturer lands"
 (layer "B.Cu")
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm && B.Type == 'Pad' && B.memberOfFootprint('U115') && (B.Pad_Number == '2' || B.Pad_Number == '4')")
 (constraint clearance (min 0.12mm)))
(rule "U115 AUXOFF exact via foreign hole clearance retained"
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm")
 (constraint hole_clearance (min 0.20mm)))
(rule "USB4105 locating holes within adapted footprint"
 (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J901') && B.memberOfFootprint('J901')")
 (constraint hole_clearance (min 0.20mm)))
