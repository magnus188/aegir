	)
	(text "Off-board; pins 1 and 9 reserved.\nJoin both ground pins at the module.\n15-90% RH: dry gas may be out of range.\nInvalid / stale data never means clean gas.\nManufacturer excludes human-safety systems."
		(exclude_from_sim no)
		(at 309.88 232.41 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
