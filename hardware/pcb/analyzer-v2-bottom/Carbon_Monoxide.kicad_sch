	(text "ZE07-CO is CO, not CO2. Wired module with a separate boosted supply and 3.0 V UART translation."
		(exclude_from_sim no)
		(at 20.32 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b83d32c-ad74-4661-b66c-53f7db3f37f1")
	)
	(text "Powered by switched 5 V; independent of the MD62 heater rail.\nTPS7A20: ceramic-stable; C706 DNP, pin4 NC. Qualify effective C and heat.\nCO_LOGIC_3V0 powers the translator only; do not use a reserved module pin."
		(exclude_from_sim no)
		(at 223.52 137.16 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "1a79218e-4807-4c92-a452-497af362c138")
	)
	(text "EXPERIMENTAL CARBON MONOXIDE CHANNEL"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "1df4d872-7467-4d09-8a11-8244a8e36b8f")
	)
	(text "A1 -> B1Y: host TX to module RX. B2 -> A2Y: module TX to host RX.\nOE is low during reset. Enable only after the CO supply is valid;\ndisable OE before power-down. Firmware: 9600 baud, 8 data bits, no parity, 1 stop."
		(exclude_from_sim no)
		(at 25.4 255.27 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "518ff046-ccd9-4d80-8643-e52314188979")
	)
	(text "0.595 x (1 + 787k/100k) = 5.278 V nominal.\nVerify >=5.0 V at the module under start-up and load; account for ripple and cable loss."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "636216d3-0cfa-40cf-a1ee-50e2d0e8904c")
	)
	(text "04  REMOTE CO MODULE & HARNESS"
		(exclude_from_sim no)
		(at 222.25 162.56 0)
		(effects
