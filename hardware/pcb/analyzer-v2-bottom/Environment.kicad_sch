	(text "02  I2C LEVEL INTERFACE"
		(exclude_from_sim no)
		(at 140.97 53.34 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2a5cb7a0-54ab-4057-b6db-b280b70e3079")
	)
	(text "GYBMEP module in the vented gas chamber. Four-wire harness, maximum 30 cm; dedicated sensor I2C at 100 kHz."
		(exclude_from_sim no)
		(at 20.32 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36e3d38a-812a-4349-8dc0-6ff22c04c48a")
	)
	(text "03  PCB HARNESS CONNECTION"
		(exclude_from_sim no)
		(at 295.91 53.34 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "99fbaa24-79e1-4524-9fe9-0e9cfb0d8d92")
	)
	(text "05  REMOTE MODULE IN THE CHAMBER"
		(exclude_from_sim no)
		(at 217.17 162.56 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aba9ffff-6883-4ee5-9ddb-607f04740ff0")
	)
	(text "Main PCB: JST-XH, 2.50 mm, 4 positions.\nWire to the module labels, not its board colour.\nVIN / GND / SCL / SDA, as photographed.\nUse strain relief at both cable ends."
		(exclude_from_sim no)
		(at 297.18 125.73 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "b7d46544-142b-464b-a9ac-812e4881c529")
	)
	(text "Fit only R601 initially. Never fit both links.\nR602 requires a verified 5 V VIN module.\nCheck the module regulator output and pull-ups\nbefore choosing an alternate supply."
		(exclude_from_sim no)
		(at 25.4 129.54 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "bdd790f4-3445-4fa6-b97c-e189e1268bbd")
	)
	(text "U601 is off-board; only J601 is mounted on the main PCB.\nKeep the sensor away from the MD62 heater and regulator.\nUse a regulated, vented chamber near atmospheric pressure.\nAllow gas contact with the sensor opening; prevent condensation.\nThis chamber sensor does not replace the battery thermistor."
		(exclude_from_sim no)
		(at 218.44 229.87 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
		(uuid "c008ee9a-e48e-44f4-a1dc-25cbd894c65e")
	)
	(text "1. Read chip ID register 0xD0: BME280 must return 0x60.\n    BMP280 does not measure humidity. Probe 0x76 and 0x77.\n\n2. Verify the actual module VDD / VDDIO and pull-up rail.\n    Chip limits: VDD 1.71-3.6 V; VDDIO 1.2-3.6 V.\n    The product photograph does not prove the fitted regulator.\n\n3. R603/R604 are unpopulated initially; use module pull-ups.\n    Fit only after checking their rail and the installed resistance.\n    Host pull-ups are on the host interface sheet.\n\n4. Measure rise time with the complete cable: <=1 us at 100 kHz.\n    Keep total bus capacitance within the device / I2C limits.\n    BSS138 translates logic; it does not isolate a stuck-low bus."
		(exclude_from_sim no)
		(at 25.4 175.26 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
		)
		(uuid "d362ece8-712f-40c7-98f7-51b3aba8e193")
	)
	(text "WIRED HUMIDITY, TEMPERATURE & PRESSURE"
