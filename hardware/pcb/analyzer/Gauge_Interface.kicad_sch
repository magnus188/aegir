	(text "GPIO28 / pin21 = I2C SDA     GPIO29 / pin14 = I2C SCL\nGPIO30 / pin12 = CO TX      GPIO31 / pin10 = CO RX (host perspective)\nGPIO32 / pin19 = power INT  GPIO33 / pin8 = power KILL\nGPIO34 / pin17 = He enable  GPIO49 / pin13 = charger INT\nGPIO50 / pin11 = USB current AUTH  GPIO51 / pin9 = CO UART enable"
		(exclude_from_sim no)
		(at 217.17 144.78 0)
		(effects
			(font
				(size 1.143 1.143)
			)
			(justify left top)
