	(text "Pin numbers match the vendor JP1 drawing. Confirm the physical mating view.\nHOST_5V flows through U302 TO Guition; HOST_3V3 returns FROM its regulator."
		(exclude_from_sim no)
		(at 217.17 129.54 0)
